<?xml version="1.0" encoding="utf-8"?>
<!-- Real Life Sky: explicit runtime permissions, merged into the main manifest as an Android library.
     Unity normally infers ACCESS_FINE_LOCATION from Input.location usage, but IL2CPP stripping can hide the
     reference; declaring them here guarantees the permission dialog can be shown on the device. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.reallife.sky.permissions">
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
</manifest>
